{
  "manifest_version": 3,
  "name": "Capital One Offers Loader",
  "version": "1.0.0",
  "description": "Automatically load all Capital One offers and filter by reward type",
  "browser_specific_settings": {
    "gecko": {
      "id": "capital-one-offers@local",
      "strict_min_version": "128.0"
    }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://capitaloneoffers.com/feed*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": ["https://capitaloneoffers.com/*"]
}
